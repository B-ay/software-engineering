<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdventureModeMathProblem">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".QuestionFragment"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-16dp">

        <ImageView
            android:id="@+id/iv_adventure_mode_math_problem3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:alpha="0.3"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/math_bg" />

        <TextView
            android:id="@+id/tv_math_user_ans"
            android:layout_width="250sp"
            android:layout_height="60sp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:text="@string/input_indicator"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_adventure_mode_math_problem5"
            app:layout_constraintVertical_bias="0.924" />

        <ImageView
            android:id="@+id/iv_adventure_mode_math_problem5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="78dp"
            android:layout_marginBottom="52dp"
            android:adjustViewBounds="true"
            android:alpha="0.85"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/img_btn_math_clear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.12"
            app:srcCompat="@drawable/math" />

        <TextView
            android:id="@+id/tv_math_problem"
            android:layout_width="250sp"
            android:layout_height="80sp"
            android:gravity="center"
            android:text="@string/出题内容"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_adventure_mode_math_problem5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/iv_adventure_mode_math_problem5"
            app:layout_constraintTop_toTopOf="@+id/iv_adventure_mode_math_problem5" />

        <Button
            android:id="@+id/btn_math_sub"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="-"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.963"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.526" />

        <ImageButton
            android:id="@+id/img_btn_math_back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.044"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_adventure_mode_math_problem3"
            app:layout_constraintVertical_bias="0.022"
            app:srcCompat="@drawable/btn_back"
            tools:ignore="SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/img_btn_math_clear"
            android:layout_width="55dp"
            android:layout_height="48dp"
            android:layout_marginBottom="483dp"
            android:adjustViewBounds="true"
            android:alpha="0.7"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/btn_math_sub"
            app:layout_constraintStart_toStartOf="@+id/btn_math_sub"
            app:layout_constraintTop_toBottomOf="@+id/iv_adventure_mode_math_problem5"
            app:srcCompat="@drawable/delete"
            tools:ignore="SpeakableTextPresentCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.38" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.78" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.68" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <Button
        android:id="@+id/btn_math_num1"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:text="1"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toTopOf="@+id/guideline11"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline6"
        app:layout_constraintTop_toTopOf="@+id/guideline4"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num2"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="2"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num1"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num1"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num1"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num3"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:text="3"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num2"
        app:layout_constraintEnd_toStartOf="@+id/guideline7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num2"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num2"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num4"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:text="4"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toTopOf="@+id/guideline12"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num5"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline6"
        app:layout_constraintTop_toTopOf="@+id/guideline11"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num5"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="5"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num4"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num6"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num4"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num4"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num6"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:text="6"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num5"
        app:layout_constraintEnd_toStartOf="@+id/guideline7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num5"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num5"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num7"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:text="7"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toTopOf="@+id/guideline10"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num8"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline6"
        app:layout_constraintTop_toTopOf="@+id/guideline12"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num8"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="8"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num7"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num7"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num7"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num9"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:text="9"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num8"
        app:layout_constraintEnd_toStartOf="@+id/guideline7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num8"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num8"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_dot"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:text="@string/button."
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@+id/guideline5"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_num0"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline6"
        app:layout_constraintTop_toTopOf="@+id/guideline10"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_num0"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="0"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_dot"
        app:layout_constraintEnd_toStartOf="@+id/btn_math_commit"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_dot"
        app:layout_constraintTop_toTopOf="@+id/btn_math_dot"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_math_commit"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="7dp"
        android:text="OK"
        android:textSize="@dimen/button_font"
        app:layout_constraintBottom_toBottomOf="@+id/btn_math_num0"
        app:layout_constraintEnd_toStartOf="@+id/guideline7"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_math_num0"
        app:layout_constraintTop_toTopOf="@+id/btn_math_num0"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.2" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.32" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10218978" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.9026764" />

</androidx.constraintlayout.widget.ConstraintLayout>