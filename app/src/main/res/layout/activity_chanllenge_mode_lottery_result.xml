<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chanllenge_lottery_background">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ChanllengeModeLotteryResult">

        <Button
            android:id="@+id/btn_continue_lottery_result"
            android:layout_width="146dp"
            android:layout_height="50dp"

            android:layout_marginTop="336dp"
            android:background="@drawable/lottery_round_button"
            android:text="继  续"

            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_lottery_result_card"
            android:layout_width="193dp"
            android:layout_height="295dp"
            android:layout_marginTop="32dp"
            android:scaleType="fitXY"
            android:alpha="0.8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/lottery_card" />

        <TextView
            android:id="@+id/tv_lottery_result_context"
            android:layout_width="125dp"
            android:layout_height="198dp"
            android:layout_marginTop="44dp"
            android:text="测试测试"
            android:gravity="center"
            android:textColor="@color/purple"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/iv_lottery_result_card"
            app:layout_constraintHorizontal_bias="0.514"
            app:layout_constraintStart_toStartOf="@+id/iv_lottery_result_card"
            app:layout_constraintTop_toTopOf="@+id/iv_lottery_result_card" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>