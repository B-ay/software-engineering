<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main2"
    tools:context=".ChanllengeModePersonNumber">

    <ImageView
        android:id="@+id/iv_person_num_4"
        android:layout_width="151dp"
        android:layout_height="83dp"
        android:layout_marginTop="180dp"
        android:layout_marginStart="55dp"
        android:scaleType="centerCrop"
        android:src="@drawable/four"
        app:layout_constraintStart_toEndOf="@+id/iv_person_num_3"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_person_num_4"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/select"
        android:textColor="#fffaf0"
        android:text="四人"
        app:layout_constraintStart_toStartOf="@+id/iv_person_num_4"
        app:layout_constraintTop_toBottomOf="@+id/iv_person_num_4" />

    <ImageView
        android:id="@+id/iv_person_num_2"
        android:layout_width="151dp"
        android:layout_height="83dp"
        android:layout_marginStart="38dp"
        android:layout_marginTop="180dp"
        android:scaleType="centerCrop"
        android:src="@drawable/two"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.196" />

    <Button
        android:id="@+id/btn_person_number_2"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/select"
        android:textColor="#fffaf0"
        android:text="双人"
        app:layout_constraintStart_toStartOf="@+id/iv_person_num_2"
        app:layout_constraintTop_toBottomOf="@+id/iv_person_num_2" />

    <ImageView
        android:id="@+id/iv_person_number_5"
        android:layout_width="151dp"
        android:layout_height="83dp"
        android:layout_marginTop="180dp"
        android:layout_marginStart="55dp"
        android:scaleType="centerCrop"
        android:src="@drawable/five"
        app:layout_constraintStart_toEndOf="@+id/iv_person_num_4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_person_number_3"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/select"
        android:textColor="#fffaf0"
        android:text="三人"
        app:layout_constraintStart_toStartOf="@+id/iv_person_num_3"
        app:layout_constraintTop_toBottomOf="@+id/iv_person_num_3" />

    <Button
        android:id="@+id/btn_person_number_5"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/select"
        android:textColor="#fffaf0"
        android:text="五人"
        app:layout_constraintStart_toStartOf="@+id/iv_person_number_5"
        app:layout_constraintTop_toBottomOf="@+id/iv_person_number_5" />

    <ImageView
        android:id="@+id/iv_person_num_3"
        android:layout_width="151dp"
        android:layout_height="83dp"
        android:layout_marginTop="180dp"
        android:layout_marginStart="55dp"
        android:scaleType="centerCrop"
        android:src="@drawable/three"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_person_num_2"
        app:layout_constraintTop_toBottomOf="@+id/tv_chanllenge_mode_person_number_prompt" />

    <TextView
        android:id="@+id/tv_chanllenge_mode_person_number_prompt"
        android:layout_width="216dp"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="68dp"
        android:text="请选择游戏人数"
        android:textColor="#228b22"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/iv_person_num_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>